{
  "name": "umu-sports-api",
  "version": "1.0.0",
  "description": "UMU Sports & Student-Athlete Management System — API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.16.1",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.3.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "6.9.14",
    "uuid": "10.0.0",
    "winston": "3.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "20.14.12",
    "@types/nodemailer": "6.4.15",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "prisma": "5.16.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4"
  }
}
