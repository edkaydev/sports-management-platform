generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SPORTS_ADMIN
  COACH
  TEAM_MANAGER
  OFFICIAL
  ACADEMIC
  ATHLETE
  UNI_ADMIN
  RECRUITER
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum AthleteType {
  REGULAR
  SCHOLARSHIP
  CONTRACT
}

enum AthleteStatus {
  ACTIVE
  INJURED
  SUSPENDED
  GRADUATED
  WITHDRAWN
  INACTIVE
}

enum SportCategory {
  TEAM
  INDIVIDUAL
}

enum TeamStaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  TEAM_MANAGER
  FITNESS_TRAINER
  PHYSIO
  OTHER
}

enum SquadMemberStatus {
  ACTIVE
  INJURED
  SUSPENDED
  TRANSFERRED
  RELEASED
}

enum AcademicStanding {
  GOOD_STANDING
  WARNING
  PROBATION
  ACADEMIC_SUSPENSION
  WITHDRAWN
}

enum Semester {
  SEM1
  SEM2
  RESIT
}

enum CourseResult {
  PASS
  FAIL
  INCOMPLETE
  WITHDRAWN
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid())
  fullName             String    @map("full_name")
  email                String    @unique
  passwordHash         String    @map("password_hash")
  role                 UserRole
  isActive             Boolean   @default(true) @map("is_active")
  phoneNumber          String?   @map("phone_number")
  profilePhotoUrl      String?   @map("profile_photo_url")
  lastLoginAt          DateTime? @map("last_login_at")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  studentAthlete StudentAthlete?
  teamStaff      TeamStaff[]
  seasonsCreated Season[]
  academicRecordsEntered AcademicRecord[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─── Seasons ──────────────────────────────────────────────────────────────────

model Season {
  id         String   @id @default(uuid())
  name       String   @unique // e.g. "2025/2026"
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  isCurrent  Boolean  @default(false) @map("is_current")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  teams      Team[]
  squadEntries TeamSquad[]
  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@map("seasons")
}

// ─── Student-Athletes ────────────────────────────────────────────────────────

model StudentAthlete {
  id                 String        @id @default(uuid())
  userId             String?       @unique @map("user_id")
  fullName           String        @map("full_name")
  registrationNumber String        @unique @map("registration_number")
  gender             Gender
  dateOfBirth        DateTime?     @map("date_of_birth")
  email              String?
  phoneNumber        String?       @map("phone_number")
  yearOfStudy        Int?          @map("year_of_study")
  programme          String?
  faculty            String?
  athleteType        AthleteType   @default(REGULAR) @map("athlete_type")
  status             AthleteStatus @default(ACTIVE)
  profilePhotoUrl    String?       @map("profile_photo_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  user               User?               @relation(fields: [userId], references: [id])
  affiliations       SportAffiliation[]
  medicalDeclaration MedicalDeclaration?
  squadEntries       TeamSquad[]
  academicRecords    AcademicRecord[]

  @@index([status])
  @@index([athleteType])
  @@index([faculty])
  @@map("student_athletes")
}

model MedicalDeclaration {
  id                   String    @id @default(uuid())
  athleteId            String    @unique @map("athlete_id")
  hasCondition         Boolean   @map("has_condition")
  conditionDescription String?   @map("condition_description")
  declaredAt           DateTime  @default(now()) @map("declared_at")
  reviewedBy           String?   @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")

  athlete StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("medical_declarations")
}

// ─── Sports & Teams ───────────────────────────────────────────────────────────

model Sport {
  id          String        @id @default(uuid())
  name        String        @unique
  gender      Gender
  category    SportCategory
  isActive    Boolean       @default(true) @map("is_active")
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  affiliations SportAffiliation[]
  teams        Team[]

  @@map("sports")
}

model Team {
  id           String    @id @default(uuid())
  name         String
  shortName    String?   @map("short_name")
  sportId      String    @map("sport_id")
  seasonId     String?   @map("season_id")
  gender       Gender
  logoUrl      String?   @map("logo_url")
  homeVenue    String?   @map("home_venue")
  foundingYear Int?      @map("founding_year")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sport        Sport               @relation(fields: [sportId], references: [id])
  season       Season?             @relation(fields: [seasonId], references: [id])
  affiliations SportAffiliation[]
  squadEntries TeamSquad[]
  staff        TeamStaff[]

  @@index([sportId])
  @@map("teams")
}

model TeamSquad {
  id           String            @id @default(uuid())
  teamId       String            @map("team_id")
  athleteId    String            @map("athlete_id")
  seasonId     String            @map("season_id")
  jerseyNumber Int?              @map("jersey_number")
  position     String?
  isCaptain    Boolean           @default(false) @map("is_captain")
  isViceCaptain Boolean          @default(false) @map("is_vice_captain")
  joinedDate   DateTime?         @map("joined_date")
  status       SquadMemberStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  team    Team           @relation(fields: [teamId], references: [id])
  athlete StudentAthlete @relation(fields: [athleteId], references: [id])
  season  Season         @relation(fields: [seasonId], references: [id])

  @@unique([teamId, athleteId, seasonId])
  @@index([athleteId])
  @@map("team_squad")
}

model TeamStaff {
  id           String        @id @default(uuid())
  teamId       String        @map("team_id")
  userId       String        @map("user_id")
  role         TeamStaffRole
  assignedDate DateTime?     @map("assigned_date")
  isActive     Boolean       @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId, role])
  @@index([userId])
  @@map("team_staff")
}

model SportAffiliation {
  id           String        @id @default(uuid())
  athleteId    String        @map("athlete_id")
  sportId      String        @map("sport_id")
  teamId       String?       @map("team_id")
  position     String?
  jerseyNumber Int?          @map("jersey_number")
  isCaptain    Boolean       @default(false) @map("is_captain")
  isViceCaptain Boolean      @default(false) @map("is_vice_captain")
  joinedDate   DateTime?     @map("joined_date")
  status       AthleteStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  athlete StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id])
  team    Team?          @relation(fields: [teamId], references: [id])

  @@unique([athleteId, sportId, teamId])
  @@index([sportId])
  @@map("sport_affiliations")
}

// ─── Academic Performance ─────────────────────────────────────────────────────

model AcademicRecord {
  id                       String           @id @default(uuid())
  athleteId                String           @map("athlete_id")
  academicYear             String           @map("academic_year") // e.g. "2025/2026"
  semester                 Semester
  yearOfStudy              Int?             @map("year_of_study")
  gpa                      Decimal?         @db.Decimal(3, 2)
  cgpa                     Decimal?         @db.Decimal(3, 2)
  totalCreditUnitsTaken    Int?             @map("total_credit_units_taken")
  totalCreditUnitsPassed   Int?             @map("total_credit_units_passed")
  failedUnits              Int              @default(0) @map("failed_units")
  attendancePercentage     Decimal?         @db.Decimal(5, 2) @map("attendance_percentage")
  academicStanding         AcademicStanding @default(GOOD_STANDING) @map("academic_standing")
  enteredBy                String?          @map("entered_by")
  notes                    String?          @db.Text
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")

  athlete       StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  enteredByUser User?          @relation(fields: [enteredBy], references: [id])
  courseResults AcademicCourseResult[]

  @@unique([athleteId, academicYear, semester])
  @@index([athleteId])
  @@index([academicStanding])
  @@map("academic_records")
}

model AcademicCourseResult {
  id               String       @id @default(uuid())
  academicRecordId String       @map("academic_record_id")
  courseCode       String       @map("course_code")
  courseName       String       @map("course_name")
  creditUnits      Int          @map("credit_units")
  marks            Decimal?     @db.Decimal(5, 2)
  grade            String?
  result           CourseResult
  retake           Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at")

  academicRecord AcademicRecord @relation(fields: [academicRecordId], references: [id], onDelete: Cascade)

  @@index([academicRecordId])
  @@map("academic_course_results")
}
