generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  TUTOR
  SPORTS_REP
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum AthleteType {
  REGULAR
  SCHOLARSHIP
  CONTRACT
}

enum AthleteStatus {
  ACTIVE
  INJURED
  SUSPENDED
  GRADUATED
  WITHDRAWN
  INACTIVE
}

enum SportCategory {
  TEAM
  INDIVIDUAL
}

enum TeamStaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  TEAM_MANAGER
  FITNESS_TRAINER
  PHYSIO
  OTHER
}

enum SquadMemberStatus {
  ACTIVE
  INJURED
  SUSPENDED
  TRANSFERRED
  RELEASED
}

enum AcademicStanding {
  GOOD_STANDING
  WARNING
  PROBATION
  ACADEMIC_SUSPENSION
  WITHDRAWN
}

enum Semester {
  SEM1
  SEM2
  RESIT
}

enum CourseResult {
  PASS
  FAIL
  INCOMPLETE
  WITHDRAWN
}

enum ScholarshipType {
  FULL
  PARTIAL
  SPONSORSHIP
  BURSARY
}

enum ScholarshipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
  RENEWED
  PENDING
}

enum ContractType {
  PLAYING
  COACHING_DEVELOPMENT
  AMBASSADOR
  OTHER
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  SUSPENDED
}

enum ProspectStatus {
  PROSPECT
  REGISTERED
  TRIAL_SCHEDULED
  TRIAL_COMPLETED
  SELECTED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum ProspectSource {
  SELF
  SCOUT
  COACH_REFERRAL
  WALK_IN
  OTHER
}

enum PreviousLevel {
  SECONDARY
  CLUB
  DISTRICT
  NATIONAL
  INTERNATIONAL
  NONE
}

enum TrialStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Recommendation {
  STRONGLY_RECOMMEND
  RECOMMEND
  NEUTRAL
  NOT_RECOMMENDED
}

enum SelectionOutcome {
  SELECTED
  RESERVE
  REJECTED
  PENDING
}

enum DocumentCategory {
  REGISTRATION
  MEDICAL
  ACADEMIC
  SCHOLARSHIP
  CONTRACT
  COMPETITION
  MATCH
  RECRUITMENT
  IDENTIFICATION
  CORRESPONDENCE
  OTHER
}

enum DocumentOwnerType {
  ATHLETE
  TEAM
  EVENT
  MATCH
  TRIAL
  DEPARTMENT
}

enum DocumentFileType {
  PDF
  JPEG
  PNG
  DOCX
  XLSX
  OTHER
}

enum DocumentStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  ARCHIVED
}

enum NotificationType {
  ACADEMIC_WARNING
  ACADEMIC_PROBATION
  FAILED_UNIT
  LOW_ATTENDANCE
  MISSING_ACADEMIC_RECORD
  SCHOLARSHIP_EXPIRING
  SCHOLARSHIP_EXPIRED
  SCHOLARSHIP_AT_RISK
  SCHOLARSHIP_REVIEW
  CONTRACT_EXPIRING
  CONTRACT_EXPIRED
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  DOCUMENT_MISSING
  FIXTURE_REMINDER
  LINEUP_DUE
  MATCH_RESULT_PENDING
  MATCH_REPORT_PENDING
  TRIAL_REMINDER
  ASSESSMENT_PENDING
  PROSPECT_AWAITING_DECISION
  POOR_FORM
  FREQUENT_CARDS
  TRAINING_ABSENCES
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum EventType {
  GALA
  TOURNAMENT
  LEAGUE
  COMPETITION
  FRIENDLY
  TRIAL
  TRAINING
  FESTIVAL
  SPECIAL
}

enum EventLevel {
  CAMPUS
  FACULTY
  UNIVERSITY
  LOCAL
  NATIONAL
  REGIONAL
  INTERNATIONAL
}

enum EventFormat {
  KNOCKOUT
  ROUND_ROBIN
  LEAGUE
  GROUP_STAGE
  SINGLE_MATCH
  OTHER
}

enum EventStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
  ABANDONED
}

enum MatchType {
  LEAGUE
  KNOCKOUT
  FRIENDLY
  GALA
  TRIAL
  OTHER
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum EquipmentCategory {
  BALL
  UNIFORM
  PROTECTIVE_GEAR
  TRAINING_TOOL
  MATCH_GEAR
  MEDICAL
  ELECTRONIC
  OFFICE
  OTHER
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum EquipmentStatus {
  AVAILABLE
  ISSUED
  UNDER_MAINTENANCE
  LOST
  RETIRED
}

enum EquipmentAssignmentType {
  ATHLETE
  TEAM
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name")
  email               String    @unique
  passwordHash        String    @map("password_hash")
  role                UserRole
  isActive            Boolean   @default(true) @map("is_active")
  phoneNumber         String?   @map("phone_number")
  profilePhotoUrl     String?   @map("profile_photo_url")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  refreshTokens          RefreshToken[]
  studentAthlete         StudentAthlete?
  teamStaff              TeamStaff[]
  seasonsCreated         Season[]
  academicRecordsEntered AcademicRecord[]
  scholarshipsAwarded    Scholarship[]
  scholarshipsRevoked    Scholarship[]        @relation("scholarshipsRevoked")
  renewalsLogged         ScholarshipRenewal[]
  contractsCreated       AthleteContract[]
  contractsTerminated    AthleteContract[]    @relation("contractsTerminated")
  prospectsCreated       Prospect[]           @relation("prospectsCreated")
  trialsConducted        Trial[]              @relation("trialsConducted")
  trialsCreated          Trial[]              @relation("trialsCreated")
  assessmentsLogged      TrialAssessment[]
  recruitsEnrolled       RecruitmentRecord[]
  documentsUploaded Document[]
  documentsVerified Document[] @relation("documentsVerified")
  notificationsReceived Notification[]
  eventsCreated Event[] @relation("eventsCreated")
  matchesCreated Match[] @relation("matchesCreated")
  lineupsSubmitted MatchLineup[]
  matchEventsRecorded MatchEvent[] @relation("matchEventsRecorded")
  matchResultsVerified MatchResult[] @relation("resultsVerified")
  matchReportsSubmitted MatchReport[]
  performancesRecorded PlayerMatchPerformance[]
  trainingSessionsCreated TrainingSession[]
  trainingAttendanceRecorded TrainingAttendance[]
  newsPosts NewsPost[] @relation("newsPosts")
  equipmentCreated EquipmentItem[] @relation("equipmentCreated")
  equipmentAssigned EquipmentAssignment[] @relation("equipmentAssigned")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

// ─── Seasons ──────────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "2025/2026"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams      Team[]
  squadEntries TeamSquad[]
  trials     Trial[]
  events     Event[]
  matches    Match[]
  trainingSessions TrainingSession[]
  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@map("seasons")
}

// ─── Student-Athletes ────────────────────────────────────────────────────────

model StudentAthlete {
  id                 String        @id @default(uuid())
  userId             String?       @unique @map("user_id")
  fullName           String        @map("full_name")
  registrationNumber String        @unique @map("registration_number")
  gender             Gender
  dateOfBirth        DateTime?     @map("date_of_birth")
  email              String?
  phoneNumber        String?       @map("phone_number")
  yearOfStudy        Int?          @map("year_of_study")
  programme          String?
  faculty            String?
  athleteType        AthleteType   @default(REGULAR) @map("athlete_type")
  status             AthleteStatus @default(ACTIVE)
  profilePhotoUrl    String?       @map("profile_photo_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  user               User?               @relation(fields: [userId], references: [id])
  affiliations       SportAffiliation[]
  medicalDeclaration MedicalDeclaration?
  squadEntries       TeamSquad[]
  academicRecords    AcademicRecord[]
  scholarships       Scholarship[]
  contracts          AthleteContract[]
  recruitmentRecord  RecruitmentRecord?
  documents          Document[]
  eventParticipants  EventParticipant[]
  homeIndividualMatches Match[] @relation("matchesHomeIndividual")
  awayIndividualMatches Match[] @relation("matchesAwayIndividual")
  matchLineupEntries MatchLineupEntry[]
  matchEvents        MatchEvent[]
  matchEventsSecondary MatchEvent[] @relation("matchEventsSecondary")
  mvpReports         MatchReport[]
  performances       PlayerMatchPerformance[]
  trainingAttendance TrainingAttendance[]
  Notification       Notification[]
  equipmentAssignments EquipmentAssignment[]

  @@index([status])
  @@index([athleteType])
  @@index([faculty])
  @@map("student_athletes")
}

model MedicalDeclaration {
  id                   String    @id @default(uuid())
  athleteId            String    @unique @map("athlete_id")
  hasCondition         Boolean   @map("has_condition")
  conditionDescription String?   @map("condition_description")
  declaredAt           DateTime  @default(now()) @map("declared_at")
  reviewedBy           String?   @map("reviewed_by")
  reviewedAt           DateTime? @map("reviewed_at")

  athlete StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("medical_declarations")
}

// ─── Sports & Teams ───────────────────────────────────────────────────────────

model Sport {
  id          String        @id @default(uuid())
  name        String        @unique
  gender      Gender
  category    SportCategory
  isActive    Boolean       @default(true) @map("is_active")
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  affiliations SportAffiliation[]
  teams        Team[]
  prospects    Prospect[]
  trials       Trial[]
  events       Event[]
  matches      Match[]
  trainingSessions   TrainingSession[]
  equipment    EquipmentItem[]

  @@map("sports")
}

model Team {
  id           String    @id @default(uuid())
  name         String
  shortName    String?   @map("short_name")
  sportId      String    @map("sport_id")
  seasonId     String?   @map("season_id")
  gender       Gender
  logoUrl      String?   @map("logo_url")
  homeVenue    String?   @map("home_venue")
  foundingYear Int?      @map("founding_year")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sport        Sport               @relation(fields: [sportId], references: [id])
  season       Season?             @relation(fields: [seasonId], references: [id])
  affiliations SportAffiliation[]
  squadEntries TeamSquad[]
  staff        TeamStaff[]
  trials       Trial[]
  documents    Document[]
  eventParticipants EventParticipant[]
  homeMatches  Match[] @relation("matchesHome")
  awayMatches  Match[] @relation("matchesAway")
  lineups      MatchLineup[]
  matchEvents  MatchEvent[]
  matchResultsWon MatchResult[]
  playerPerformances PlayerMatchPerformance[]
  trainingSessions   TrainingSession[]
  equipmentAssignments EquipmentAssignment[]

  @@index([sportId])
  @@map("teams")
}

model TeamSquad {
  id            String            @id @default(uuid())
  teamId        String            @map("team_id")
  athleteId     String            @map("athlete_id")
  seasonId      String            @map("season_id")
  jerseyNumber  Int?              @map("jersey_number")
  position      String?
  isCaptain     Boolean           @default(false) @map("is_captain")
  isViceCaptain Boolean           @default(false) @map("is_vice_captain")
  joinedDate    DateTime?         @map("joined_date")
  status        SquadMemberStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  team    Team           @relation(fields: [teamId], references: [id])
  athlete StudentAthlete @relation(fields: [athleteId], references: [id])
  season  Season         @relation(fields: [seasonId], references: [id])

  @@unique([teamId, athleteId, seasonId])
  @@index([athleteId])
  @@map("team_squad")
}

model TeamStaff {
  id           String        @id @default(uuid())
  teamId       String        @map("team_id")
  userId       String        @map("user_id")
  role         TeamStaffRole
  assignedDate DateTime?     @map("assigned_date")
  isActive     Boolean       @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId, role])
  @@index([userId])
  @@map("team_staff")
}

model SportAffiliation {
  id            String        @id @default(uuid())
  athleteId     String        @map("athlete_id")
  sportId       String        @map("sport_id")
  teamId        String?       @map("team_id")
  position      String?
  jerseyNumber  Int?          @map("jersey_number")
  isCaptain     Boolean       @default(false) @map("is_captain")
  isViceCaptain Boolean       @default(false) @map("is_vice_captain")
  joinedDate    DateTime?     @map("joined_date")
  status        AthleteStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  athlete StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id])
  team    Team?          @relation(fields: [teamId], references: [id])

  @@unique([athleteId, sportId, teamId])
  @@index([sportId])
  @@map("sport_affiliations")
}

// ─── Academic Performance ─────────────────────────────────────────────────────

model AcademicRecord {
  id                     String           @id @default(uuid())
  athleteId              String           @map("athlete_id")
  academicYear           String           @map("academic_year") // e.g. "2025/2026"
  semester               Semester
  yearOfStudy            Int?             @map("year_of_study")
  gpa                    Decimal?         @db.Decimal(3, 2)
  cgpa                   Decimal?         @db.Decimal(3, 2)
  totalCreditUnitsTaken  Int?             @map("total_credit_units_taken")
  totalCreditUnitsPassed Int?             @map("total_credit_units_passed")
  failedUnits            Int              @default(0) @map("failed_units")
  attendancePercentage   Decimal?         @map("attendance_percentage") @db.Decimal(5, 2)
  academicStanding       AcademicStanding @default(GOOD_STANDING) @map("academic_standing")
  enteredBy              String?          @map("entered_by")
  notes                  String?          @db.Text
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  athlete       StudentAthlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  enteredByUser User?                  @relation(fields: [enteredBy], references: [id])
  courseResults AcademicCourseResult[]

  @@unique([athleteId, academicYear, semester])
  @@index([athleteId])
  @@index([academicStanding])
  @@map("academic_records")
}

model AcademicCourseResult {
  id               String       @id @default(uuid())
  academicRecordId String       @map("academic_record_id")
  courseCode       String       @map("course_code")
  courseName       String       @map("course_name")
  creditUnits      Int          @map("credit_units")
  marks            Decimal?     @db.Decimal(5, 2)
  grade            String?
  result           CourseResult
  retake           Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at")

  academicRecord AcademicRecord @relation(fields: [academicRecordId], references: [id], onDelete: Cascade)

  @@index([academicRecordId])
  @@map("academic_course_results")
}

// ─── Scholarships & Contracts ─────────────────────────────────────────────────

model Scholarship {
  id                     String            @id @default(uuid())
  athleteId              String            @map("athlete_id")
  scholarshipType        ScholarshipType   @map("scholarship_type")
  sponsorName            String?           @map("sponsor_name")
  coverageDescription    String?           @map("coverage_description")
  coveragePercentage     Decimal?          @map("coverage_percentage") @db.Decimal(5, 2)
  startDate              DateTime          @map("start_date")
  endDate                DateTime          @map("end_date")
  renewable              Boolean           @default(false)
  renewalCount           Int               @default(0) @map("renewal_count")
  status                 ScholarshipStatus @default(PENDING)
  academicRequirementGpa Decimal?          @map("academic_requirement_gpa") @db.Decimal(3, 2)
  sportsRequirement      String?           @map("sports_requirement")
  awardedBy              String?           @map("awarded_by")
  awardedAt              DateTime?         @default(now()) @map("awarded_at")
  revokedBy              String?           @map("revoked_by")
  revokedAt              DateTime?         @map("revoked_at")
  revocationReason       String?           @map("revocation_reason")
  notes                  String?           @db.Text
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  athlete       StudentAthlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  awardedByUser User?                @relation(fields: [awardedBy], references: [id])
  revokedByUser User?                @relation("scholarshipsRevoked", fields: [revokedBy], references: [id])
  renewals      ScholarshipRenewal[]
  contracts     AthleteContract[]

  @@index([athleteId])
  @@index([status])
  @@index([endDate])
  @@map("scholarships")
}

model ScholarshipRenewal {
  id              String   @id @default(uuid())
  scholarshipId   String   @map("scholarship_id")
  previousEndDate DateTime @map("previous_end_date")
  newEndDate      DateTime @map("new_end_date")
  renewedBy       String   @map("renewed_by")
  renewedAt       DateTime @default(now()) @map("renewed_at")
  gpaAtRenewal    Decimal? @map("gpa_at_renewal") @db.Decimal(3, 2)
  notes           String?  @db.Text
  renewalNumber   Int      @map("renewal_number")

  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  renewedByUser User        @relation(fields: [renewedBy], references: [id])

  @@index([scholarshipId])
  @@map("scholarship_renewals")
}

model AthleteContract {
  id                         String         @id @default(uuid())
  athleteId                  String         @map("athlete_id")
  contractType               ContractType   @map("contract_type")
  startDate                  DateTime       @map("start_date")
  endDate                    DateTime       @map("end_date")
  termsSummary               String?        @map("terms_summary")
  hasAccompanyingScholarship Boolean        @default(false) @map("has_accompanying_scholarship")
  scholarshipId              String?        @map("scholarship_id")
  signedByAthlete            Boolean        @default(false) @map("signed_by_athlete")
  signedAt                   DateTime?      @map("signed_at")
  status                     ContractStatus @default(ACTIVE)
  createdBy                  String?        @map("created_by")
  createdAt                  DateTime       @default(now()) @map("created_at")
  terminatedBy               String?        @map("terminated_by")
  terminationDate            DateTime?      @map("termination_date")
  terminationReason          String?        @map("termination_reason")
  notes                      String?        @db.Text
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  athlete          StudentAthlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  scholarship      Scholarship?   @relation(fields: [scholarshipId], references: [id])
  createdByUser    User?          @relation(fields: [createdBy], references: [id])
  terminatedByUser User?          @relation("contractsTerminated", fields: [terminatedBy], references: [id])

  @@index([athleteId])
  @@index([status])
  @@index([endDate])
  @@map("athlete_contracts")
}

// ─── Recruitment & Trials ─────────────────────────────────────────────────────

model Prospect {
  id                   String         @id @default(uuid())
  fullName             String         @map("full_name")
  email                String?
  phoneNumber          String?        @map("phone_number")
  gender               Gender
  dateOfBirth          DateTime?      @map("date_of_birth")
  schoolOrInstitution  String?        @map("school_or_institution")
  programmeApplied     String?        @map("programme_applied")
  sportId              String         @map("sport_id")
  position             String?
  previousLevel        PreviousLevel? @map("previous_level")
  previousClubs        String?        @map("previous_clubs")
  previousAchievements String?        @map("previous_achievements")
  referredBy           String?        @map("referred_by")
  source               ProspectSource @default(SELF)
  status               ProspectStatus @default(PROSPECT)
  notes                String?        @db.Text
  createdBy            String?        @map("created_by")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  sport         Sport              @relation(fields: [sportId], references: [id])
  createdByUser User?              @relation("prospectsCreated", fields: [createdBy], references: [id])
  trialEntries  TrialParticipant[]
  assessments   TrialAssessment[]
  recruitment   RecruitmentRecord?

  @@index([sportId])
  @@index([status])
  @@map("prospects")
}

model Trial {
  id          String      @id @default(uuid())
  sportId     String      @map("sport_id")
  teamId      String?     @map("team_id")
  trialDate   DateTime    @map("trial_date")
  startTime   String?     @map("start_time")
  venue       String?
  conductedBy String?     @map("conducted_by")
  seasonId    String?     @map("season_id")
  description String?     @db.Text
  status      TrialStatus @default(SCHEDULED)
  createdBy   String?     @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sport              Sport               @relation(fields: [sportId], references: [id])
  team               Team?               @relation(fields: [teamId], references: [id])
  season             Season?             @relation(fields: [seasonId], references: [id])
  conductedByUser    User?               @relation("trialsConducted", fields: [conductedBy], references: [id])
  createdByUser      User?               @relation("trialsCreated", fields: [createdBy], references: [id])
  participants       TrialParticipant[]
  assessments        TrialAssessment[]
  recruitmentRecords RecruitmentRecord[]
  documents          Document[]

  @@index([sportId])
  @@index([trialDate])
  @@map("trials")
}

model TrialParticipant {
  id         String   @id @default(uuid())
  trialId    String   @map("trial_id")
  prospectId String   @map("prospect_id")
  attended   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  trial    Trial    @relation(fields: [trialId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([trialId, prospectId])
  @@index([prospectId])
  @@map("trial_participants")
}

model TrialAssessment {
  id                  String           @id @default(uuid())
  trialId             String           @map("trial_id")
  prospectId          String           @map("prospect_id")
  assessedBy          String?          @map("assessed_by")
  assessedAt          DateTime         @default(now()) @map("assessed_at")
  scoreTechnical      Decimal?         @map("score_technical") @db.Decimal(3, 1)
  scorePhysical       Decimal?         @map("score_physical") @db.Decimal(3, 1)
  scoreSpeed          Decimal?         @map("score_speed") @db.Decimal(3, 1)
  scoreTactical       Decimal?         @map("score_tactical") @db.Decimal(3, 1)
  scoreTeamwork       Decimal?         @map("score_teamwork") @db.Decimal(3, 1)
  scoreDiscipline     Decimal?         @map("score_discipline") @db.Decimal(3, 1)
  scoreAcademic       Decimal?         @map("score_academic") @db.Decimal(3, 1)
  overallScore        Decimal?         @map("overall_score") @db.Decimal(3, 1)
  recommendedPosition String?          @map("recommended_position")
  recommendation      Recommendation   @default(NEUTRAL)
  selectionOutcome    SelectionOutcome @default(PENDING)
  coachNotes          String?          @map("coach_notes")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  trial          Trial    @relation(fields: [trialId], references: [id], onDelete: Cascade)
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  assessedByUser User?    @relation(fields: [assessedBy], references: [id])

  recruitmentRecord RecruitmentRecord?

  @@unique([trialId, prospectId])
  @@index([prospectId])
  @@map("trial_assessments")
}

model RecruitmentRecord {
  id           String    @id @default(uuid())
  athleteId    String    @unique @map("athlete_id")
  prospectId   String    @unique @map("prospect_id")
  trialId      String?   @map("trial_id")
  assessmentId String?   @unique @map("assessment_id")
  enrolledDate DateTime? @map("enrolled_date")
  enrolledBy   String?   @map("enrolled_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  athlete        StudentAthlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  prospect       Prospect         @relation(fields: [prospectId], references: [id])
  trial          Trial?           @relation(fields: [trialId], references: [id])
  assessment     TrialAssessment? @relation(fields: [assessmentId], references: [id])
  enrolledByUser User?            @relation(fields: [enrolledBy], references: [id])

  @@index([athleteId])
  @@map("recruitment_records")
}

// ─── Documents & Records ──────────────────────────────────────────────────────

model Document {
  id            String            @id @default(uuid())
  title         String
  category      DocumentCategory
  fileUrl       String            @map("file_url")
  fileName      String            @map("file_name")
  fileType      DocumentFileType  @default(OTHER) @map("file_type")
  fileSizeBytes Int?              @map("file_size_bytes")
  ownerType     DocumentOwnerType @map("owner_type")
  athleteId     String?           @map("athlete_id")
  teamId        String?           @map("team_id")
  eventId       String?           @map("event_id")
  matchId       String?           @map("match_id")
  trialId       String?           @map("trial_id")
  expiryDate    DateTime?         @map("expiry_date")
  status        DocumentStatus    @default(ACTIVE)
  isVerified    Boolean           @default(false) @map("is_verified")
  verifiedBy    String?           @map("verified_by")
  verifiedAt    DateTime?         @map("verified_at")
  uploadedBy    String            @map("uploaded_by")
  uploadedAt    DateTime          @default(now()) @map("uploaded_at")
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  athlete        StudentAthlete? @relation(fields: [athleteId], references: [id])
  team           Team?           @relation(fields: [teamId], references: [id])
  event          Event?          @relation(fields: [eventId], references: [id])
  match          Match?          @relation(fields: [matchId], references: [id])
  trial          Trial?          @relation(fields: [trialId], references: [id])
  uploadedByUser User            @relation(fields: [uploadedBy], references: [id])
  verifiedByUser User?           @relation("documentsVerified", fields: [verifiedBy], references: [id])

  @@index([athleteId])
  @@index([ownerType])
  @@index([category])
  @@index([status])
  @@map("documents")
}

// ─── Notifications & Alerts ───────────────────────────────────────────────────

model Notification {
  id                String               @id @default(uuid())
  type              NotificationType
  severity          NotificationSeverity @default(INFO)
  title             String
  message           String               @db.Text
  recipientUserId   String               @map("recipient_user_id")
  relatedAthleteId  String?              @map("related_athlete_id")
  relatedEntityType String?              @map("related_entity_type")
  relatedEntityId   String?              @map("related_entity_id")
  isRead            Boolean              @default(false) @map("is_read")
  readAt            DateTime?            @map("read_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  expiresAt         DateTime?            @map("expires_at")

  recipient      User?           @relation(fields: [recipientUserId], references: [id])
  relatedAthlete StudentAthlete? @relation(fields: [relatedAthleteId], references: [id])

  @@index([recipientUserId, isRead])
  @@index([type])
  @@map("notifications")
}

// ─── Events & Competitions ────────────────────────────────────────────────────

model Event {
  id                    String      @id @default(uuid())
  name                  String
  type                  EventType
  level                 EventLevel
  sportId               String?     @map("sport_id")
  seasonId              String?     @map("season_id")
  organizer             String?
  hostInstitution       String?     @map("host_institution")
  venue                 String?
  startDate             DateTime?   @map("start_date")
  endDate               DateTime?   @map("end_date")
  description           String?     @db.Text
  status                EventStatus @default(PLANNED)
  format                EventFormat @default(OTHER)
  maxTeams              Int?        @map("max_teams")
  maxParticipants       Int?        @map("max_participants")
  registrationDeadline  DateTime?   @map("registration_deadline")
  createdBy             String?     @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  sport     Sport?         @relation(fields: [sportId], references: [id])
  season    Season?        @relation(fields: [seasonId], references: [id])
  createdByUser User?      @relation("eventsCreated", fields: [createdBy], references: [id])
  participants EventParticipant[]
  matches    Match[]
  documents  Document[]

  @@index([type])
  @@index([level])
  @@index([startDate])
  @@map("events")
}

model EventParticipant {
  id              String   @id @default(uuid())
  eventId         String   @map("event_id")
  participantType String   @map("participant_type") // TEAM | INDIVIDUAL
  teamId          String?  @map("team_id")
  athleteId       String?  @map("athlete_id")
  registeredAt    DateTime @default(now()) @map("registered_at")
  status          String   @default("REGISTERED")

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team    Team?           @relation(fields: [teamId], references: [id])
  athlete StudentAthlete? @relation(fields: [athleteId], references: [id])

  @@unique([eventId, teamId])
  @@unique([eventId, athleteId])
  @@index([eventId])
  @@map("event_participants")
}

model Match {
  id                 String      @id @default(uuid())
  eventId            String      @map("event_id")
  sportId            String      @map("sport_id")
  seasonId           String?     @map("season_id")
  matchNumber        Int?        @map("match_number")
  round              String?
  homeTeamId         String?     @map("home_team_id")
  awayTeamId         String?     @map("away_team_id")
  homeIndividualId   String?     @map("home_individual_id")
  awayIndividualId   String?     @map("away_individual_id")
  venue              String?
  scheduledDate      DateTime    @map("scheduled_date")
  scheduledTime      String?     @map("scheduled_time")
  actualStartTime    DateTime?   @map("actual_start_time")
  actualEndTime      DateTime?   @map("actual_end_time")
  homeScore          Int?        @map("home_score")
  awayScore          Int?        @map("away_score")
  status             MatchStatus @default(SCHEDULED)
  matchType          MatchType   @default(OTHER) @map("match_type")
  notes              String?     @db.Text
  createdBy          String?     @map("created_by")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  event           Event           @relation(fields: [eventId], references: [id])
  sport           Sport           @relation(fields: [sportId], references: [id])
  season          Season?         @relation(fields: [seasonId], references: [id])
  homeTeam        Team?           @relation("matchesHome", fields: [homeTeamId], references: [id])
  awayTeam        Team?           @relation("matchesAway", fields: [awayTeamId], references: [id])
  homeIndividual  StudentAthlete? @relation("matchesHomeIndividual", fields: [homeIndividualId], references: [id])
  awayIndividual  StudentAthlete? @relation("matchesAwayIndividual", fields: [awayIndividualId], references: [id])
  createdByUser   User?           @relation("matchesCreated", fields: [createdBy], references: [id])
  lineups         MatchLineup[]
  events          MatchEvent[]
  results         MatchResult?
  report          MatchReport?
  documents       Document[]
  performances    PlayerMatchPerformance[]

  @@index([eventId])
  @@index([scheduledDate])
  @@index([status])
  @@map("matches")
}

model MatchLineup {
  id           String    @id @default(uuid())
  matchId      String    @map("match_id")
  teamId       String    @map("team_id")
  submittedBy  String    @map("submitted_by")
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  isConfirmed  Boolean   @default(false) @map("is_confirmed")

  match      Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team       Team           @relation(fields: [teamId], references: [id])
  submittedByUser User      @relation(fields: [submittedBy], references: [id])
  entries    MatchLineupEntry[]

  @@unique([matchId, teamId])
  @@map("match_lineups")
}

model MatchLineupEntry {
  id            String  @id @default(uuid())
  lineupId      String  @map("lineup_id")
  athleteId     String  @map("athlete_id")
  jerseyNumber  Int?    @map("jersey_number")
  position      String?
  isStarter     Boolean @default(false) @map("is_starter")
  isCaptain     Boolean @default(false) @map("is_captain")
  order         Int?

  lineup  MatchLineup    @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  athlete StudentAthlete @relation(fields: [athleteId], references: [id])

  @@index([lineupId])
  @@map("match_lineup_entries")
}

model MatchEvent {
  id                  String     @id @default(uuid())
  matchId             String     @map("match_id")
  eventType           String     @map("event_type")
  minute              Int?       @map("minute")
  teamId              String?    @map("team_id")
  athleteId           String?    @map("athlete_id")
  secondaryAthleteId  String?    @map("secondary_athlete_id")
  details             String?    @db.Text
  recordedBy          String?    @map("recorded_by")
  recordedAt          DateTime   @default(now()) @map("recorded_at")

  match            Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team             Team?           @relation(fields: [teamId], references: [id])
  athlete          StudentAthlete? @relation(fields: [athleteId], references: [id])
  secondaryAthlete StudentAthlete? @relation("matchEventsSecondary", fields: [secondaryAthleteId], references: [id])
  recordedByUser   User?           @relation("matchEventsRecorded", fields: [recordedBy], references: [id])

  @@index([matchId])
  @@map("match_events")
}

model MatchResult {
  id                 String     @id @default(uuid())
  matchId            String     @unique @map("match_id")
  homeScore          Int        @map("home_score")
  awayScore          Int        @map("away_score")
  winnerTeamId       String?    @map("winner_team_id")
  resultType         String     @map("result_type") // HOME_WIN | AWAY_WIN | DRAW | penalties
  homePenalties      Int?       @map("home_penalties")
  awayPenalties      Int?       @map("away_penalties")
  walkover           Boolean    @default(false)
  verifiedBy         String?    @map("verified_by")
  verifiedAt         DateTime?  @map("verified_at")

  match        Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerTeam   Team? @relation(fields: [winnerTeamId], references: [id])
  verifiedByUser User? @relation("resultsVerified", fields: [verifiedBy], references: [id])

  @@map("match_results")
}

model MatchReport {
  id                String    @id @default(uuid())
  matchId           String    @unique @map("match_id")
  submittedBy       String    @map("submitted_by")
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  summary           String?   @db.Text
  mvpAthleteId      String?   @map("mvp_athlete_id")
  attendanceCount   Int?      @map("attendance_count")
  notableIncidents  String?   @map("notable_incidents") @db.Text
  coachingNotes     String?   @map("coaching_notes") @db.Text

  match        Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedByUser User         @relation(fields: [submittedBy], references: [id])
  mvpAthlete   StudentAthlete? @relation(fields: [mvpAthleteId], references: [id])

  @@map("match_reports")
}

// ─── Player Performance ───────────────────────────────────────────────────────

model PlayerMatchPerformance {
  id                    String     @id @default(uuid())
  matchId               String     @map("match_id")
  athleteId             String     @map("athlete_id")
  teamId                String     @map("team_id")
  minutesPlayed         Int        @map("minutes_played")
  points                Int?       @default(0)
  assists               Int?       @default(0)
  rebounds              Int?       @default(0)
  steals                Int?       @default(0)
  blocks                Int?       @default(0)
  goals                 Int?       @default(0)
  shotsOnTarget         Int?       @map("shots_on_target")
  saves                 Int?       @default(0)
  tackles               Int?       @default(0)
  interceptions         Int?       @default(0)
  passesCompleted       Int?       @map("passes_completed")
  passesAttempted       Int?       @map("passes_attempted")
  fouls                 Int?       @default(0)
  yellowCards           Int?       @map("yellow_cards") @default(0)
  redCards              Int?       @map("red_cards") @default(0)
  sprints               Int?       @default(0)
  distanceCoveredKm     Decimal?   @map("distance_covered_km") @db.Decimal(5, 2)
  maxSpeedKph           Decimal?   @map("max_speed_kph") @db.Decimal(5, 2)
  rating                Decimal?   @db.Decimal(3, 1)
  notes                 String?    @db.Text
  recordedBy            String     @map("recorded_by")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete       StudentAthlete  @relation(fields: [athleteId], references: [id])
  team          Team            @relation(fields: [teamId], references: [id])
  recordedByUser User           @relation(fields: [recordedBy], references: [id])

  @@unique([matchId, athleteId])
  @@index([athleteId])
  @@index([matchId])
  @@map("player_match_performances")
}

model TrainingSession {
  id            String         @id @default(uuid())
  sportId       String         @map("sport_id")
  teamId        String?        @map("team_id")
  seasonId      String?        @map("season_id")
  title         String
  location      String?
  sessionDate   DateTime       @map("session_date")
  startTime     String?        @map("start_time")
  endTime       String?        @map("end_time")
  focusAreas    String?        @map("focus_areas") @db.Text
  intensity     String?
  status        TrainingStatus @default(SCHEDULED)
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  sport         Sport                    @relation(fields: [sportId], references: [id])
  team          Team?                    @relation(fields: [teamId], references: [id])
  season        Season?                  @relation(fields: [seasonId], references: [id])
  createdByUser User                     @relation(fields: [createdBy], references: [id])
  attendance    TrainingAttendance[]

  @@index([sessionDate])
  @@map("training_sessions")
}

model TrainingAttendance {
  id            String           @id @default(uuid())
  sessionId     String           @map("session_id")
  athleteId     String           @map("athlete_id")
  status        AttendanceStatus @default(PRESENT)
  notes         String?          @db.Text
  recordedBy    String?          @map("recorded_by")
  recordedAt    DateTime         @default(now()) @map("recorded_at")

  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete      StudentAthlete  @relation(fields: [athleteId], references: [id])
  recordedByUser User?         @relation(fields: [recordedBy], references: [id])

  @@unique([sessionId, athleteId])
  @@index([athleteId])
  @@map("training_attendance")
}

// ─── News & Announcements ───────────────────────────────────────────────────

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsPost {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String     @db.Text
  coverImage  String?    @map("cover_image")
  tags        String?
  featured    Boolean    @default(false)
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at")
  authorId    String?    @map("author_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author User? @relation("newsPosts", fields: [authorId], references: [id])

  @@index([status])
  @@index([publishedAt])
  @@map("news_posts")
}

// ─── Department Equipment & Inventory (TUTOR only) ───────────────────────────

model EquipmentItem {
  id              String             @id @default(uuid())
  name            String
  category        EquipmentCategory
  assetNumber     String?            @unique @map("asset_number")
  serialNumber    String?            @map("serial_number")
  quantity        Int                @default(1)
  condition       EquipmentCondition @default(NEW)
  status          EquipmentStatus    @default(AVAILABLE)
  sportId         String?            @map("sport_id")
  storageLocation String?            @map("storage_location")
  purchasedDate   DateTime?          @map("purchased_date")
  purchaseCost    Decimal?           @map("purchase_cost") @db.Decimal(10, 2)
  notes           String?            @db.Text
  createdBy       String?            @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  sport        Sport?               @relation(fields: [sportId], references: [id])
  createdByUser User?               @relation("equipmentCreated", fields: [createdBy], references: [id])
  assignments  EquipmentAssignment[]

  @@index([category])
  @@index([status])
  @@index([sportId])
  @@map("equipment_items")
}

model EquipmentAssignment {
  id               String                 @id @default(uuid())
  equipmentId      String                 @map("equipment_id")
  assignedToType   EquipmentAssignmentType @map("assigned_to_type")
  athleteId        String?                @map("athlete_id")
  teamId           String?                @map("team_id")
  quantity         Int                    @default(1)
  assignedBy       String                 @map("assigned_by")
  assignedAt       DateTime               @default(now()) @map("assigned_at")
  dueDate          DateTime?              @map("due_date")
  returnedAt       DateTime?              @map("returned_at")
  conditionOnReturn EquipmentCondition?   @map("condition_on_return")
  notes            String?                @db.Text

  equipment   EquipmentItem    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  athlete     StudentAthlete?  @relation(fields: [athleteId], references: [id])
  team        Team?            @relation(fields: [teamId], references: [id])
  assignedByUser User?         @relation("equipmentAssigned", fields: [assignedBy], references: [id])

  @@index([equipmentId])
  @@index([athleteId])
  @@index([teamId])
  @@map("equipment_assignments")
}
